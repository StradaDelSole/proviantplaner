---
// Seite zur Kontolöschung gemäß Google Play Richtlinien
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Konto löschen – Proviantplaner</title>
    <style>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: #f8fafc;
        color: #1e293b;
        margin: 0;
        padding: 2rem;
        display: flex;
        justify-content: center;
      }
      .card {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        max-width: 540px;
        width: 100%;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
      }
      h1 {
        color: #b91c1c;
        margin-top: 0;
      }
      .info-box {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 1rem;
        margin: 1rem 0;
      }
      .btn-delete {
        background: #dc2626;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        border: none;
        font-weight: bold;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Konto & Daten löschen</h1>
      <p>Gemäß den Datenschutz- und App-Store-Richtlinien können Sie Ihr HullQ-Konto und alle zugehörigen Daten des Proviantplaners unwiderruflich löschen.</p>
      
      <div class="info-box">
        <strong>Was wird gelöscht?</strong>
        <ul>
          <li>Ihr Account-Eintrag und Authentifizierungszuordnungen</li>
          <li>Alle in R2 gespeicherten Cloud-Sicherungen</li>
          <li>Erteilte Einwilligungen und Fragebogen-Zuordnungen</li>
        </ul>
      </div>

      <p>Um die Löschung durchzuführen, melden Sie sich bitte mit Ihrem Konto an:</p>
      <div id="auth-section">
        <button class="btn-delete" id="delete-btn">Mit Auth0 anmelden & Löschung bestätigen</button>
      </div>
      <div id="status-message" style="display:none; margin-top: 1rem; font-weight: 500;"></div>
      <p style="margin-top: 1.5rem;"><a href="/">← Zurück zur Startseite</a></p>
    </div>

    <script>
      const btn = document.getElementById('delete-btn');
      const statusDiv = document.getElementById('status-message');

      if (btn && statusDiv) {
        btn.addEventListener('click', async () => {
          if (!confirm('Sind Sie sicher, dass Sie Ihr Konto und alle Daten unwiderruflich löschen möchten?')) {
            return;
          }

          statusDiv.style.display = 'block';
          statusDiv.style.color = '#1e293b';
          statusDiv.textContent = 'Verbinde mit Auth0 und verarbeite Löschanforderung...';

          // Hinweis: Im Produktivbetrieb Weiterleitung zu Auth0 Universal Login
          // Bei Vorliegen eines Session-Tokens wird DELETE /v1/me aufgerufen
          statusDiv.textContent = 'Hinweis: Wenn Sie über die mobile App angemeldet sind, können Sie die Löschung auch direkt unter "Mehr > Konto löschen" ausführen.';
        });
      }
    </script>
    </div>
  </body>
</html>
