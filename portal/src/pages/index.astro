---
// Proviantplaner Portal (Cloudflare Pages)
// Gemäß BACKEND_KONZEPT_v0.2 Abschnitt 6
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Proviantplaner – Portal</title>
    <style>
      :root {
        --color-primary: #003366;
        --color-surface: #f8fafc;
        --color-text: #1e293b;
      }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: var(--color-surface);
        color: var(--color-text);
        margin: 0;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .card {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        max-width: 500px;
        width: 100%;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
      }
      h1 {
        color: var(--color-primary);
        margin-top: 0;
      }
      ul {
        padding-left: 1.2rem;
        line-height: 1.8;
      }
      a {
        color: var(--color-primary);
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Proviantplaner Portal</h1>
      <p>Web-Dienste und Schnittstellen für die Proviant- und Bordkassenplanung:</p>
      <ul>
        <li><a href="/konto-loeschen">Konto löschen (Google Play Anforderung)</a></li>
        <li>Crew-Fragebogen (über Törn-spezifische Links erreichbar)</li>
        <li>Charter-Administration (über Auth0-Login)</li>
      </ul>
      <p><small>powered by HullQ</small></p>
    </div>
  </body>
</html>
